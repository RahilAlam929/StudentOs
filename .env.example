# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/studentos
DATABASE_USERNAME=studentos
DATABASE_PASSWORD=studentos

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (generate a secure random string for production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI (optional — mock responses used when unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=mock

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
