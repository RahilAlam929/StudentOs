# -----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# -----------------------------------------------------------------------------

if [ -z "${MAVEN_SKIP_RC}" ] ; then
  if [ -f /etc/mavenrc ] ; then
    . /etc/mavenrc
  fi
  if [ -f "${HOME}/.mavenrc" ] ; then
    . "${HOME}/.mavenrc"
  fi
fi

# OS specific support. $var _must_ be set to either true or false.
cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true ;;
  Darwin*) darwin=true
    if [ -z "${JAVA_HOME}" ] && [ -x "/usr/libexec/java_home" ]; then
      JAVA_HOME="$(/usr/libexec/java_home)"
    fi
    ;;
esac

if [ -z "${JAVA_HOME}" ] ; then
  if [ -n "${JAVA_HOME_21_X64}" ] ; then
    JAVA_HOME="${JAVA_HOME_21_X64}"
  fi
fi

if [ -z "${MAVEN_PROJECTBASEDIR}" ] ; then
  MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-"$(cd "$(dirname "$0")" && pwd)"}"
fi

MAVEN_OPTS="${MAVEN_OPTS:-"-Xmx1024m -XX:MaxMetaspaceSize=256m"}"

WRAPPER_JAR="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

if [ ! -e "${WRAPPER_JAR}" ] ; then
  echo "Downloading Maven Wrapper JAR..."
  WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  mkdir -p "${MAVEN_PROJECTBASEDIR}/.mvn/wrapper"
  if command -v curl > /dev/null 2>&1 ; then
    curl -fsSL -o "${WRAPPER_JAR}" "${WRAPPER_URL}"
  elif command -v wget > /dev/null 2>&1 ; then
    wget -q -O "${WRAPPER_JAR}" "${WRAPPER_URL}"
  else
    echo "Error: curl or wget required to download Maven Wrapper JAR" >&2
    exit 1
  fi
fi

exec "${JAVA_HOME}/bin/java" \
  ${MAVEN_OPTS} \
  -classpath "${WRAPPER_JAR}" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  ${WRAPPER_LAUNCHER} "$@"
